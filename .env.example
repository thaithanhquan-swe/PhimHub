# Không bắt buộc cấu hình API key vì API phim.nguonc.com là miễn phí và công khai
# VITE_API_BASE=https://phim.nguonc.com/api
# Đặt URL gốc HTTPS của website đã deploy để bot mạng xã hội tải được ảnh Open Graph
# VITE_SITE_URL=https://phimhub-kappa.vercel.app

VITE_BACKEND_API_BASE=http://localhost:3000

# Backend-only secret; use a random value of at least 32 characters and never prefix it with VITE_
IP_HASH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
